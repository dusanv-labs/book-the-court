# Copy this file to .env and fill in real values. Never commit .env.
# PostgreSQL connection string, e.g. from Neon (postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full)
DATABASE_URL=
# Long random string used to sign login tokens
JWT_SECRET=
PORT=3000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Used only by "npm run db:seed" to create the admin user
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
