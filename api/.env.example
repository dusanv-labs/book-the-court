# Copy this file to .env and fill in real values. Never commit .env.
# PostgreSQL connection string, e.g. from Neon (postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full)
DATABASE_URL=
# Long random string used to sign login tokens
JWT_SECRET=
PORT=3000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Used only by "npm run db:seed" to create the admin user
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# AI booking assistant (optional). Without a key the assistant is switched off.
# Create a key at https://console.anthropic.com and keep a spend limit on the account.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
# Limits for the public demo: questions per day (whole site), estimated USD per day, questions per day per IP
ASSISTANT_DAILY_REQUESTS=20
ASSISTANT_DAILY_BUDGET_USD=1
ASSISTANT_IP_DAILY_REQUESTS=10
# Online card payment with Stripe Checkout (optional). Without a key, players pay at the venue.
# Test mode keys only (sk_test_...): https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...). Locally: "stripe listen --forward-to localhost:3000/api/payments/webhook".
# Without it, a payment is checked when the player comes back from the payment page.
STRIPE_WEBHOOK_SECRET=
# Public address of the web app; Stripe sends players back here after paying
WEB_URL=http://localhost:5173/
